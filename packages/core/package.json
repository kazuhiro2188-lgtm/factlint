{
  "name": "@factlint/core",
  "version": "0.1.0",
  "description": "Deterministic grounding checker for numbers in AI-generated text. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "keywords": ["llm", "hallucination", "grounding", "eval", "ai", "verification", "lint"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
