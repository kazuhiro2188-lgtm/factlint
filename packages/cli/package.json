{
  "name": "factlint",
  "version": "0.1.0",
  "description": "CLI to verify that numbers in AI-generated text are grounded in the source data. No LLM involved.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "factlint": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "llm",
    "hallucination",
    "grounding",
    "ci",
    "lint",
    "ai",
    "eval"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "factlint-core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazuhiro2188-lgtm/factlint.git"
  },
  "homepage": "https://github.com/kazuhiro2188-lgtm/factlint#readme",
  "bugs": {
    "url": "https://github.com/kazuhiro2188-lgtm/factlint/issues"
  }
}
