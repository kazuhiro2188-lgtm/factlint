{
  "name": "factlint-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic hallucination linter for numbers in AI-generated text",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
